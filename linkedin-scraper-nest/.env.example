# Application
NODE_ENV=development
PORT=3000

# Database
DB_PATH=../data/my_database.db

# AI API Keys (OpenRouter)
# Note: These can also be configured in config.json
JOB_ANALYSIS_API_KEY=sk-or-v1-xxx
JOB_ANALYSIS_MODEL=openai/gpt-4o

COVER_LETTER_API_KEY=sk-or-v1-xxx
COVER_LETTER_MODEL=google/gemini-2.5-flash-lite

RESUME_API_KEY=sk-or-v1-xxx
RESUME_MODEL=google/gemini-2.5-flash-lite

PAGE_SCRAPER_API_KEY=sk-or-v1-xxx
PAGE_SCRAPER_MODEL=google/gemini-2.5-flash-lite

# Files
RESUME_PATH=../CV.pdf
